# ── Database ──────────────────────────────────────────────────────────────────
# Local MongoDB:
#   MONGO_URI=mongodb://localhost:27017/ecommerce
# MongoDB Atlas (SRV URIs automatically enable a DNS workaround):
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce
MONGO_URI=mongodb://localhost:27017/ecommerce
DB_NAME=ecommerce

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use a long, random string. Never commit the real value.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Stripe ────────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use sk_test_/pk_test_ outside production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Signing secret for the webhook endpoint. In local dev, run:
#   stripe listen --forward-to localhost:3000/api/payments/webhook
# and copy the whsec_... value it prints.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# ISO-4217 code your Stripe account settles in.
STRIPE_CURRENCY=usd
